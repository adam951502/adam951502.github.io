{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-index.schema.json",
  "title": "Portfolio project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectFiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "projectFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^projects/[a-z0-9-]+\\.json$"
      }
    }
  }
}
