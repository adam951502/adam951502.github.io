{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gooaye-stt-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "JOBS"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "STT_QUEUE",
        "queue": "gooaye-stt-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "gooaye-stt-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "686001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "vars": {
    "MAX_AUDIO_BYTES": "83886080",
    "CHUNK_BYTES": "1048576",
    "RESULT_TTL_SECONDS": "604800"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
